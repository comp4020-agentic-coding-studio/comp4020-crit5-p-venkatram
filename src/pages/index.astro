---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brace the Mast</title>
    <meta
      name="description"
      content="A wind-battered mast sways on the shore. Brace it before it snaps."
    />

    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="visually-hidden">
      <nav aria-label="Primary">
        <a href="./">Brace the Mast</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">Brace the Mast</h1>
      <canvas id="scene" aria-label="A tall wooden mast leaning in the wind on a sandy shore."></canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>

---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bolt the Engine</title>
    <meta
      name="description"
      content="A shuddering engine block sits on a garage test rig, its mounts rattling looser as the throttle climbs."
    />

    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="visually-hidden">
      <nav aria-label="Primary">
        <a href="./">Bolt the Engine</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">Bolt the Engine</h1>
      <canvas id="scene" aria-label="An engine block vibrating on a garage test rig, its four mounts shaking loose."></canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>

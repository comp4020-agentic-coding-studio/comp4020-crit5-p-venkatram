---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Letter Head</title>
    <meta
      name="description"
      content="A reel of letters and a mind map of four word slots that race a closing ring."
    />

    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="visually-hidden">
      <nav aria-label="Primary">
        <a href="./">Letter Head</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">Letter Head</h1>
      <div class="layout">
        <div id="app">
          <div id="map">
            <button id="hub" type="button" aria-label="A reel cycling through the alphabet.">
              <svg id="ring" viewBox="0 0 100 100" aria-hidden="true">
                <circle class="ring-track" cx="50" cy="50" r="45" />
                <circle id="ring-progress" cx="50" cy="50" r="45" />
              </svg>
              <div id="reel-window">
                <div id="reel-strip"></div>
              </div>
            </button>

            <div class="node node-nw" data-category="name">
              <span class="node-label">Name</span>
              <input type="text" aria-label="Name" autocomplete="off" autocapitalize="off" spellcheck="false" />
            </div>
            <div class="node node-ne" data-category="place">
              <span class="node-label">Place</span>
              <input type="text" aria-label="Place" autocomplete="off" autocapitalize="off" spellcheck="false" />
            </div>
            <div class="node node-sw" data-category="animal">
              <span class="node-label">Animal</span>
              <input type="text" aria-label="Animal" autocomplete="off" autocapitalize="off" spellcheck="false" />
            </div>
            <div class="node node-se" data-category="thing">
              <span class="node-label">Thing</span>
              <input type="text" aria-label="Thing" autocomplete="off" autocapitalize="off" spellcheck="false" />
            </div>

            <button type="button" class="lost-banner" id="lost-banner" aria-label="Restart">
              <span class="score" id="score"></span>
            </button>
          </div>
        </div>

        <aside id="history" aria-label="Previous answers">
          <div class="history-header">
            <span></span>
            <span>Name</span>
            <span>Place</span>
            <span>Animal</span>
            <span>Thing</span>
          </div>
          <ol id="history-list"></ol>
        </aside>
      </div>
    </main>

    <div id="score-badge"><span id="score-live">0</span></div>

    <div id="best-badge" aria-label="Best score this browser">
      <span id="best-label">Best</span>
      <span id="best-live">0</span>
    </div>

    <div id="brand" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="11" fill="#1c2650" stroke="#4a5aa8" stroke-width="1.5"></circle>
        <text x="12" y="16.5" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="800" font-size="12" fill="#ffd166">L</text>
      </svg>
    </div>

    <button id="end-game" type="button" aria-label="End">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M13 3h-2v10h2V3zm4.83 2.17-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.24 1.06-4.32 2.83-5.65L6.41 4.93A8.93 8.93 0 0 0 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9a8.93 8.93 0 0 0-3.17-6.83z"
        ></path>
      </svg>
    </button>
    <button id="refresh" type="button" aria-label="Restart">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-8 3.58-8 8s3.58 8 8 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
        ></path>
      </svg>
    </button>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
